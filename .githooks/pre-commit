#!/usr/bin/env bash
#
# Runs before every commit: formatting and clippy. The tests and the
# gates are in the pre-push hook.
#
# Turn the hooks on once per clone:
#
#     git config core.hooksPath .githooks
#
# To commit without them: `git commit --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# The roadmap and the completions ledger are kept outside this
# repository. `.gitignore` names them, but `git add -f` gets past
# `.gitignore`, so refuse them here as well.
if git diff --cached --name-only | grep -qE '^docs/roadmap(-progress)?\.md$'; then
  echo "pre-commit: docs/roadmap.md and docs/roadmap-progress.md are kept" >&2
  echo "            outside this repository. Unstage them." >&2
  exit 1
fi

# cargo is not always on PATH.
if ! command -v cargo > /dev/null 2>&1; then
  [[ -x $HOME/.cargo/bin/cargo ]] || {
    echo "pre-commit: no cargo found. Put it on PATH." >&2
    exit 1
  }
  PATH="$HOME/.cargo/bin:$PATH"
  export PATH
fi

# A workflow that runs the tests has to build the data tree first, or it
# goes red on ten tests that name a missing file and not the reason. That
# happened, and nothing here would have said so before the push.
#
# The check is per file, not per job: it asks that a workflow running
# `cargo test` also runs `tools/build-itshfbc.sh` somewhere. A workflow
# with two jobs could still satisfy it wrongly. It is a reminder in the
# right place, not a proof — running the workflows is what proves it.
for workflow in .github/workflows/*.yml; do
  if grep -q 'cargo test' "$workflow" &&
    ! grep -q 'build-itshfbc.sh' "$workflow"; then
    echo "pre-commit: $workflow runs the tests and never builds the" >&2
    echo "            itshfbc tree they read. Add:" >&2
    echo >&2
    echo "                tools/build-itshfbc.sh" >&2
    exit 1
  fi
done

echo "pre-commit: formatting"
cargo fmt --check

echo "pre-commit: clippy"
cargo clippy --all-targets --all-features -- -D warnings
